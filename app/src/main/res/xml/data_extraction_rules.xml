<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 禁止备份任何应用数据，防止 API Key 泄露 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
